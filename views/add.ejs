<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Post</title>

  <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://use.hugeicons.com/font/icons.css">
  <link rel="stylesheet" href="stylesheets/create.css">
</head>
<body>
  
  <nav class="nav_bar bg-neutral-primary fixed w-full z-20 top-0 start-0 border-b border-default">
    <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
      <a href="/profile" class="flex items-center space-x-3 rtl:space-x-reverse">
          <img src="https://flowbite.com/docs/images/logo.svg" class="h-7" alt="Flowbite Logo" />
          <span class="self-center text-xl text-heading font-semibold whitespace-nowrap">Pinterest</span>
      </a>
      <button data-collapse-toggle="navbar-default" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-body rounded-base md:hidden hover:bg-neutral-secondary-soft hover:text-heading focus:outline-none focus:ring-2 focus:ring-neutral-tertiary" aria-controls="navbar-default" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14"/></svg>
      </button>
      <div class="hidden w-full md:block md:w-auto" id="navbar-default">
        <ul class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-default rounded-base bg-neutral-secondary-soft md:flex-row md:space-x-8 rtl:space-x-reverse md:mt-0 md:border-0 md:bg-neutral-primary">
          <li>
            <a href="/about"
              class="block py-2 px-3 text-heading rounded hover:bg-neutral-tertiary md:hover:bg-transparent md:border-0 md:hover:text-fg-brand md:p-0 md:dark:hover:bg-transparent">About</a>
          </li>
          <li>
            <a href="/profile"
              class="block py-2 px-3 text-heading rounded hover:bg-neutral-tertiary md:hover:bg-transparent md:border-0 md:hover:text-fg-brand md:p-0 md:dark:hover:bg-transparent">Profile</a>
          </li>
          <li>
            <a href="/add" style="color: green; font-weight: 700;"
              class=" block py-2 px-3 text-heading rounded hover:bg-neutral-tertiary md:hover:bg-transparent md:border-0 md:hover:text-fg-brand md:p-0 md:dark:hover:bg-transparent">Create</a>
          </li>
          <li>
            <a href="/feed"
              class="block py-2 px-3 text-heading rounded hover:bg-neutral-tertiary md:hover:bg-transparent md:border-0 md:hover:text-fg-brand md:p-0 md:dark:hover:bg-transparent">Feed</a>
          </li>

          <li>
            <a href="/logout"
              class="logoutbtn block py-2 px-3 text-heading rounded hover:bg-neutral-tertiary md:hover:bg-transparent md:border-0 md:hover:text-fg-brand md:p-0 md:dark:hover:bg-transparent">LogOut</a>
          </li>
        </ul>
      </div>
    </div>
</nav>

<h1 class="mainhead">Create New Post</h1>


  <div class="addform">

    <form action="/createpost" method="post" enctype="multipart/form-data">
        <br>
        
        <label for="inputimage" class="dropbox"> 
          <div class="iconbox">
            <i class="icon hgi hgi-stroke hgi-rounded hgi-image-upload"></i><br><br>
            <span for="exampleFormControlInput1" id="imagelable" class="form-label">Select Image</span>
          </div>
          <input id="inputimage" type="file" accept="image/*" hidden name="postimage" >
        </label>
        <br><br>
        
        <label style=" margin-bottom:5px" for="exampleFormControlInput1" class="form-label">Title</label><br>
        <input type="text" class=" inputspace form-control" name="title" placeholder="Post Title">
        <br><br>
        <label style="margin-top: 20px; margin-bottom:5px" for="exampleFormControlTextarea1" class="form-label">Discription</label><br>
        <textarea class="inputspace form-control" name="discription"  rows="4" cols="23"></textarea><br>
        <input class="subbtn" type="submit" class="form-control"  value="Create Post">
        <br><br>

    </form>
    
</div>

<div class="bottomtext">
  <p style="margin-top: -2px;">Designed by <a style="font-weight: 700;">Neeraj</a> Distributed by<a
      style="font-weight: 700;"> Code-N-Play</a></p>
</div>


<script src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>

<script>
  const imageinput = document.getElementById("inputimage");
  const lable =  document.getElementById("imagelable");
  imageinput.addEventListener("change" , function(){
    
    if(this.files.length>0){
      lable.innerHTML = '<h1 style="color: green; font-weight: 700; font-size: 30px;" > Selected </h1>';
      lable.classList.add("Selected");
    }else{
      lable.innerHTML = "choose Image";
      lable.classList.remove("Selected");
    }
  });
</script>
</body>
</html>
