  <div>
    <h1 class="main_head" >Create the life you love on Pinterest</h1>
  <br><br>
  <!-- Modal toggle -->
  <button data-modal-target="authentication-modal-signup" data-modal-toggle="authentication-modal-signup" class=" btn_main text-white bg-brand box-border border border-transparent hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-1 focus:outline-none" type="button">
    Join Pinterest for free
  </button>
  
    <!-- Modal toggle -->
  <button data-modal-target="authentication-modal-login" data-modal-toggle="authentication-modal-login" class=" btn_main_2 text-white bg-brand box-border border border-transparent hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-1 focus:outline-none" type="button">
    I already have an account
  </button>
  </div>
    
    <!-- Main modal -->
    <div id="authentication-modal-login" tabindex="-1" aria-hidden="true" class="  hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class=" relative p-4 w-full max-w-md max-h-full">
            <!-- Modal content -->
            <div class="login_card relative bg-neutral-primary-soft border border-default rounded-base shadow-sm p-4 md:p-6">
                <!-- Modal header -->
                <div class="flex items-center justify-between border-b border-default pb-4 md:pb-5">
                    <h3 class="text-lg font-medium text-heading" style="text-align: center;">
                        Welcome to Pinterest
                    </h3>
                    <button type="button" class="text-body bg-transparent hover:bg-neutral-tertiary hover:text-heading rounded-base text-sm w-9 h-9 ms-auto inline-flex justify-center items-center" data-modal-hide="authentication-modal-login">
                        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
                        <span class="sr-only">Close modal</span>
                    </button>
                </div>
                <!-- Modal body -->
                <form action="/login" method="post" class="pt-4 md:pt-6">
                    <div class="mb-4">
                        <label for="email" class="block mb-2.5 text-sm font-medium text-heading">User Name</label>
                        <input type="text" id="email" name="username" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="User Name" required />
                    </div>
                    <div>
                        <label for="password" class="block mb-2.5 text-sm font-medium text-heading">Your password</label>
                        <input type="password" id="password" name="password" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="•••••••••" required />
                    </div>
                    <div class="flex items-start my-6">
                        
                        <a href="#" class="ms-auto text-sm font-medium text-fg-brand hover:underline">Forget Password?</a>
                    </div>
                    <button type="submit" class="btn_main text-white bg-brand box-border border border-transparent hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-1 focus:outline-none w-full mb-3">Login to your account</button>
                    <div class="text-sm font-medium text-body">Not registered? <a href="/" class="text-fg-brand hover:underline">Create account</a></div>
                </form>
            </div>
        </div>
    </div> 
  
  
    
    <!-- Main modal -->
    <div id="authentication-modal-signup" tabindex="-1" aria-hidden="true" class="  hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-md max-h-full">
            <!-- Modal content -->
            <div class="login_card relative bg-neutral-primary-soft border border-default rounded-base shadow-sm p-4 md:p-6">
                <!-- Modal header -->
                <div class="flex items-center justify-between border-b border-default pb-4 md:pb-5">
                    <h3 class="text-lg font-medium text-heading" style="text-align: center;">
                        Welcome to Pinterest
                    </h3><br>
                    
                    <button type="button" class="text-body bg-transparent hover:bg-neutral-tertiary hover:text-heading rounded-base text-sm w-9 h-9 ms-auto inline-flex justify-center items-center" data-modal-hide="authentication-modal-signup">
                        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
                        <span class="sr-only">Close modal</span>
                    </button>
                </div>
                
                
                <!-- Modal body -->
                <form action="/" method="post" class="pt-4 md:pt-6">
                    <div class="mb-4">
                        <input type="email" id="email" name="email" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="example@company.com" required />
                    </div>
                    <div class="mb-4">
                      <input type="text" id="email" name="username" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="User Name" required />
                    </div>
                    <div class="mb-4">
                      <input type="text" id="email" name="name" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Name" required />
                    </div>
                    <div class="mb-4">
                      <input type="number" id="password" name="contact" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Contact" required />
                    </div>
                    <div>
                        <input type="password" id="password" name="password" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Create Password" required />
                    </div>
                    <P style="font-size: 11px;" class="px-3 py-4">Use 8 or more letters, numbers and symbols</P>
                    
                    <div>
                      <input type="date" id="password" name="dob" class="input_box bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-base focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" placeholder="Enter Your date of birth (DD/MM/YYYY)" required />
                  </div>
  
                    <div class="flex items-start my-6">
                        
                      
                    </div>
                    <button type="submit" class="btn_main text-white bg-brand box-border border border-transparent hover:bg-brand-strong focus:ring-4 focus:ring-brand-medium shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-1 focus:outline-none w-full mb-3">Continue</button>
                    <div class="text-sm font-medium text-body">Already have an account? <a href="/login" class="text-fg-brand hover:underline">Log in</a></div>
                </form>
            </div>
        </div>
    </div> 
  
  
  
